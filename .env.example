# Server Configuration
PORT=3000

# Database Configuration (Turso SQLite)
# Example: libsql://<db-name>-<org-name>.turso.io?authToken=<token>
DATABASE_URL="libsql://your-db-name-your-org.turso.io?authToken=your-auth-token"
DATABASE_AUTH_TOKEN="your-auth-token"

# JWT Secret for Authentication
JWT_SECRET="supersecretjwtkeythatshouldbeverylongandrandom"

# Multi-tenancy Header
# This header will be used to identify the tenant for each request.
# Example: X-Tenant-ID
TENANT_HEADER="X-Tenant-ID"

# Default Admin User (for initial setup/seeding)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="securepassword123"

# Application Details
APP_NAME="Aplikasi Buat Satu Aplikasi Enterprise"
APP_DOMAIN="https://appbuilder.example.com"

# Frontend URL (for CORS, if frontend is separate)
FRONTEND_URL="http://localhost:5173"